# ---------------------------------------------------------------------------
# Python bytecode / build artefacts
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
*.manifest
*.spec

# ---------------------------------------------------------------------------
# Model weights — downloaded bases and trained outputs
#
# from_pretrained() writes to <cwd>/checkpoint/<model>/, so every collection
# model folder grows its own multi-GB checkpoint/ directory.
# ---------------------------------------------------------------------------
checkpoint/
collections/*/checkpoint/
collections/*/*/checkpoint/
model_pretrained/
*.ckpt
*.pth
*.pt
*.bin
*.safetensors
*.gguf
*.onnx

# ---------------------------------------------------------------------------
# Lightning / experiment tracking output
# ---------------------------------------------------------------------------
logs/
lightning_logs/
training_logs/
collections/*/logs/
collections/*/lightning_logs/
collections/*/training_logs/
*.log
nohup.out

# Other trackers, in case they get used later
wandb/
mlruns/
.neptune/
runs/
outputs/

# ---------------------------------------------------------------------------
# Credentials — never commit these
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
.lightning/
lightning_credentials.json
*.pem
*.key
secrets.json

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
.venv/
venv/
env/
ENV/
.python-version
.conda/

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# ---------------------------------------------------------------------------
# Tooling caches
#
# unsloth_compiled_cache/ is generated source that Unsloth writes on import.
# Its location comes from UNSLOTH_COMPILE_LOCATION, which defaults to a RELATIVE
# path and so lands in whatever directory the process was launched from. The
# training scripts pin it to their own folder, but the bare pattern is listed
# here too so a stray copy from another cwd never gets committed.
# ---------------------------------------------------------------------------
unsloth_compiled_cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# Misc runtime junk
# ---------------------------------------------------------------------------
core
core.*
*.tmp
tmp/
